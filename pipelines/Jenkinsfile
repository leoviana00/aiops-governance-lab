node {

    env.DEPLOY_INCIDENT = "0"

    // ==============================
    // Stage 1 - SCM
    // ==============================

    stage("SCM") {

        echo "Checkout do repositório"

        git(
            branch: "master",
            credentialsId: "GitInJenkins",
            url: "git@gitlab:root/springboot-demo.git"
        )

    }

    // ==============================
    // Stage 2 - Change Telemetry
    // ==============================

    stage("Change Telemetry") {

        script {

            env.COMMIT_SHA = sh(
                script: "git rev-parse HEAD",
                returnStdout: true
            ).trim()

            // timestamp do commit (DORA Lead Time)
            env.COMMIT_TIMESTAMP = sh(
                script: "git log -1 --pretty=%cI | xargs -I{} date -u -d {} +%Y-%m-%dT%H:%M:%SZ",
                returnStdout: true
            ).trim()

            env.COMMIT_AUTHOR = sh(
                script: "git log --no-merges -1 --pretty=%an",
                returnStdout: true
            ).trim()

            env.COMMIT_MESSAGE = sh(
                script: "git log --no-merges -1 --pretty=%s",
                returnStdout: true
            ).trim()

            echo "Commit message detected: ${env.COMMIT_MESSAGE}"
            echo "Commit timestamp: ${env.COMMIT_TIMESTAMP}"

            env.FILES_CHANGED = sh(
                script: "git diff --name-only HEAD~1 2>/dev/null | wc -l || echo 0",
                returnStdout: true
            ).trim()

            env.LINES_ADDED = sh(
                script: """
                git diff --numstat HEAD~1 2>/dev/null | awk '{add+=\$1} END {print add+0}'
                """,
                returnStdout: true
            ).trim()

            env.LINES_REMOVED = sh(
                script: """
                git diff --numstat HEAD~1 2>/dev/null | awk '{del+=\$2} END {print del+0}'
                """,
                returnStdout: true
            ).trim()

            env.MODULES_AFFECTED = sh(
                script: """
                git diff --name-only HEAD~1 2>/dev/null | cut -d/ -f1 | sort -u | wc -l
                """,
                returnStdout: true
            ).trim()

        }

    }

    // ==============================
    // Stage 3 - Merge Request Context
    // ==============================

    stage("Merge Request Context") {

        script {

            def mrId = env.gitlabMergeRequestIid

            def sourceBranch = sh(
                script: """
                git log -1 --pretty=%s | sed -n "s/Merge branch '\\(.*\\)' into.*/\\1/p"
                """,
                returnStdout: true
            ).trim()

            if (!sourceBranch) {
                sourceBranch = env.gitlabSourceBranch ?: "unknown"
            }

            def targetBranch = env.gitlabTargetBranch ?: env.BRANCH_NAME ?: "master"

            def mrAuthor = env.gitlabUserName ?: env.COMMIT_AUTHOR ?: "unknown"

            env.MR_ID = mrId ?: ""
            env.MR_SOURCE_BRANCH = sourceBranch
            env.MR_TARGET_BRANCH = targetBranch
            env.MR_AUTHOR = mrAuthor

        }

    }

    // ==============================
    // Stage 4 - Change Governance
    // ==============================

    stage("Change Governance Telemetry") {

        script {

            env.CHANGE_TYPE = sh(
                script: """
                echo "${env.COMMIT_MESSAGE}" | grep -oE '^(feat|fix|docs|chore|refactor|test|perf|hotfix)' || true
                """,
                returnStdout: true
            ).trim()

            if (!env.CHANGE_TYPE) {
                env.CHANGE_TYPE = "unknown"
            }

            env.SEMANTIC_COMMIT = sh(
                script: """
                echo "${env.COMMIT_MESSAGE}" | \
                grep -E '^(feat|fix|docs|chore|refactor|test|perf|hotfix)(\\(.+\\))?: .+' \
                >/dev/null && echo true || echo false
                """,
                returnStdout: true
            ).trim()

            env.BRANCH_TYPE = sh(
                script: "git branch --show-current | cut -d'/' -f1",
                returnStdout: true
            ).trim()

            if (env.COMMIT_AUTHOR == env.MR_AUTHOR) {
                env.SELF_APPROVED = "true"
            } else {
                env.SELF_APPROVED = "false"
            }

        }

    }

    // ==============================
    // Stage 5 - Build
    // ==============================

    stage("Build") {
        sh "./mvnw clean package -DskipTests"
    }

    // ==============================
    // Stage 6 - Test
    // ==============================

    stage("Test") {

        sh "./mvnw test"
        junit 'target/surefire-reports/*.xml'

    }

    // ==============================
    // Stage 7 - Evidence Generation
    // ==============================

    stage("Evidence Generation") {

        script {

            def evidence = [

                commit: [
                    sha: env.COMMIT_SHA,
                    timestamp: env.COMMIT_TIMESTAMP,
                    author: env.COMMIT_AUTHOR,
                    message: env.COMMIT_MESSAGE
                ],

                merge_request: [
                    id: env.MR_ID,
                    source_branch: env.MR_SOURCE_BRANCH,
                    target_branch: env.MR_TARGET_BRANCH,
                    author: env.MR_AUTHOR
                ],

                change_metrics: [
                    files_changed: env.FILES_CHANGED as Integer,
                    lines_added: env.LINES_ADDED as Integer,
                    lines_removed: env.LINES_REMOVED as Integer,
                    modules_affected: env.MODULES_AFFECTED as Integer
                ],

                governance: [
                    change_type: env.CHANGE_TYPE,
                    semantic_commit: env.SEMANTIC_COMMIT,
                    branch_type: env.BRANCH_TYPE,
                    self_approved: env.SELF_APPROVED
                ]

            ]

            writeFile file: "evidence.json",
            text: groovy.json.JsonOutput.prettyPrint(
                groovy.json.JsonOutput.toJson(evidence)
            )

        }

        archiveArtifacts artifacts: 'evidence.json'

    }

    // ==============================
    // Stage 8 - Prepare AIOps Event
    // ==============================

    stage("Prepare AIOps Event") {

        script {

            def aiopsEvent = [

                commit_sha: env.COMMIT_SHA,
                commit_timestamp: env.COMMIT_TIMESTAMP,

                author: env.COMMIT_AUTHOR,

                change_metrics: [
                    files_changed: env.FILES_CHANGED as Integer,
                    lines_added: env.LINES_ADDED as Integer,
                    lines_removed: env.LINES_REMOVED as Integer,
                    modules_affected: env.MODULES_AFFECTED as Integer
                ],

                governance: [
                    change_type: env.CHANGE_TYPE,
                    semantic_commit: env.SEMANTIC_COMMIT == "true",
                    branch_type: env.BRANCH_TYPE,
                    self_approved: env.SELF_APPROVED == "true"
                ],

                merge_request: [
                    id: env.MR_ID,
                    source_branch: env.MR_SOURCE_BRANCH,
                    target_branch: env.MR_TARGET_BRANCH
                ]
            ]

            writeFile file: "aiops-event.json",
            text: groovy.json.JsonOutput.prettyPrint(
                groovy.json.JsonOutput.toJson(aiopsEvent)
            )

        }

    }

    // ==============================
    // Stage 9 - Send Change Event
    // ==============================

    stage("Send Change Event") {

        sh """
        curl -s -X POST http://aiops-agent:8000/change-event \
        -H "Content-Type: application/json" \
        -d @aiops-event.json
        """

    }

    // ==============================
    // Stage 10 - Risk Prediction
    // ==============================

    stage("AIOps Risk Prediction") {

        sh """
        curl -s -X POST http://aiops-agent:8000/predict \
        -H "Content-Type: application/json" \
        -d @aiops-event.json > ai-risk.json
        """

        sh "cat ai-risk.json"

    }

    // ==============================
    // Stage 11 - Deployment Decision
    // ==============================

    stage("Deployment Decision") {

        script {

            def risk = readJSON file: "ai-risk.json"

            if (!risk.risk_probability) {
                echo "Modelo ainda não treinado"
                return
            }

            def probability = risk.risk_probability as Double

            if (probability >= 0.70) {
                error "Deploy bloqueado por risco alto"
            }

            if (probability >= 0.40) {
                input message: "Deploy de risco médio. Aprovar?"
            }

        }

    }

    // ==============================
    // Stage 12 - Deploy
    // ==============================

    stage("Deploy Application") {

        script {

            env.DEPLOY_TIMESTAMP = sh(
                script: "date -u +%Y-%m-%dT%H:%M:%SZ",
                returnStdout: true
            ).trim()

            sh """
            chmod +x deploy.sh
            ./deploy.sh
            """

        }

    }

    // ==============================
    // Stage 13 - Health Check
    // ==============================

    stage("Health Check") {

        script {

            def status = sh(
                script: "curl -s -o /dev/null -w \"%{http_code}\" http://springboot-demo:8086/health || echo 000",
                returnStdout: true
            ).trim()

            if (status != "200") {
                env.DEPLOY_INCIDENT = "1"
            }

        }

    }

    // ==============================
    // Stage 14 - Functional Validation
    // ==============================

    stage("Post Deploy Validation") {

        script {

            def status = sh(
                script: "curl -s -o /dev/null -w \"%{http_code}\" http://springboot-demo:8086/products || echo 500",
                returnStdout: true
            ).trim()

            if (status != "200") {
                env.DEPLOY_INCIDENT = "1"
            }

        }

    }

    // ==============================
    // Stage 15 - Incident Feedback
    // ==============================

    stage("Incident Feedback") {

        sh """
        curl -s -X POST http://aiops-agent:8000/incident-feedback \
        -H "Content-Type: application/json" \
        -d '{
            "commit_sha": "${env.COMMIT_SHA}",
            "incident": ${env.DEPLOY_INCIDENT},
            "deploy_timestamp": "${env.DEPLOY_TIMESTAMP}"
        }'
        """

    }

    // ==============================
    // Stage 16 - Model Training
    // ==============================

    stage("AIOps Model Training") {

        sh """
        curl -s -X POST http://aiops-agent:8000/train
        """

    }

}